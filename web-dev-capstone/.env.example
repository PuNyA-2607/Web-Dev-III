# Application Configuration
NODE_ENV=development
PORT=5000

# Database (replica set connection string required for multi-document transactions)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_inventory?replicaSet=rs0

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3000

# Seed Admin Credentials
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_seed_password_here
